{
  "name": "ds-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "init-ds": "node scripts/init-ds.mjs",
    "dev:storybook": "pnpm --filter storybook-web dev",
    "build": "pnpm --filter \"./packages/*\" run --if-present build",
    "build:storybook": "pnpm --filter storybook-web build",
    "adr-index": "node scripts/adr-index.mjs",
    "adr-index:check": "node scripts/adr-index.mjs --check",
    "design-index": "node scripts/design-index.mjs",
    "design-index:check": "node scripts/design-index.mjs --check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm adr-index:check && pnpm design-index:check && pnpm verify:docs && pnpm verify:figma && pnpm build && pnpm test",
    "verify:figma": "node scripts/verify-figma.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "typecheck": "tsc --noEmit -p packages/react/tsconfig.json && tsc --noEmit -p apps/storybook/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "clean": "node -e \"for (const p of ['packages/react/dist','packages/tokens/build','apps/storybook/storybook-static','node_modules/.vite']) require('fs').rmSync(p,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
